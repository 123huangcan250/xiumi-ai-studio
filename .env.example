# ---- AI（任选其一；不配置时使用内置规则排版）----
# OpenAI 兼容接口：DeepSeek / MiMo / MiniMax / 通义 等
AI_PROVIDER=openai
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
# 或 Anthropic
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_MODEL=claude-sonnet-5-5

# ---- 微信公众号（仅在你本人确认后用于草稿箱推送）----
# 需要在公众号后台配置服务器 IP 白名单
WECHAT_APPID=
WECHAT_APPSECRET=

API_PORT=5174

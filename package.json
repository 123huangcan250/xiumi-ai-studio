{
  "name": "xiumi-ai-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "可视化微信公众号图文编辑器 + AI 自动排版",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "node --import isomorphic-dompurify node_modules/@playwright/test/cli.js test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "sample": "tsx scripts/make-sample.ts",
    "probe": "tsx scripts/make-xiumi-probe.ts",
    "package:win": "tsx scripts/package-win.ts",
    "verify:package": "tsx scripts/verify-package.ts",
    "e2e:package": "cross-env E2E_TARGET=packaged node --import isomorphic-dompurify node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/extension-color": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "dompurify": "3.4.17",
    "express": "^5.3.0",
    "fflate": "0.8.3",
    "isomorphic-dompurify": "3.0.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.2",
    "multer": "^2.5.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.4",
    "sharp": "^0.35.5",
    "undici": "^8.12.4",
    "zustand": "^5.0.16",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/jsdom": "28.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "29.1.1",
    "postject": "1.0.0-alpha.6",
    "rcedit": "5.0.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "@types/yauzl": "3.4.0",
    "jszip": "3.10.2"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.19.0"
  }
}
